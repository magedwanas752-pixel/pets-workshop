---
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "دفتر الذكريات",
  description = "دفتر خاص لحفظ صورك وحكاياتك الجميلة.",
} = Astro.props;
---

<!doctype html>
<!--
THESIS: A visit feels like opening a private keepsake, safe behind a personal key.
OWN-WORLD: Warm handmade paper, botanical ink, pressed-flower pink, sage, and taped photographs.
STORY: Set a private password, open the book, and keep photographs beside the stories that matter.
FIRST VIEWPORT: A quiet Arabic welcome, a flower-sealed envelope, and a clear password form.
FORM: The pinned botanical letter language becomes a private scrapbook; no seed content or outside service.
-->
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f5f0e5" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span class="footer-flower" aria-hidden="true">✿</span>
      <p id="storage-footer">ذكرياتك محفوظة في هذا الجهاز فقط.</p>
      <span id="footer-love">بكل حب</span>
    </footer>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    color-scheme: light;
    --paper: #f5f0e5;
    --paper-deep: #ebe2d1;
    --paper-light: #fffaf0;
    --photo-paper: #fffdf6;
    --ink: #403632;
    --ink-soft: #685a51;
    --ink-faint: #84766c;
    --sage: #71826d;
    --sage-dark: #4e624d;
    --rose: #bb7772;
    --rose-dark: #8d4e4b;
    --honey: #c4a569;
    --line: #d7cbb7;
    --font-display: Georgia, "Times New Roman", serif;
    --font-body: "Avenir Next", Avenir, "Segoe UI", sans-serif;
    --font-hand: "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive;
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--paper);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(ellipse at 12% 18%, rgb(197 165 105 / 9%), transparent 29rem),
      radial-gradient(ellipse at 89% 31%, rgb(187 119 114 / 8%), transparent 27rem),
      repeating-linear-gradient(3deg, rgb(121 97 71 / 2%) 0 1px, transparent 1px 5px),
      var(--paper);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.75;
  }

  a {
    color: inherit;
  }

  button,
  a,
  input,
  textarea,
  summary {
    -webkit-tap-highlight-color: transparent;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--rose-dark);
    outline-offset: 4px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.3;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  h3 {
    font-size: 1.5rem;
  }

  [hidden] {
    display: none !important;
  }

  .page-shell {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-footer {
    display: flex;
    min-height: 88px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-flower {
    color: var(--rose);
    font-size: 1.25rem;
  }

  @media (max-width: 620px) {
    .page-shell {
      width: min(100% - 32px, 520px);
    }

    .site-footer {
      flex-wrap: wrap;
      gap: 8px;
      padding-inline: 16px;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
