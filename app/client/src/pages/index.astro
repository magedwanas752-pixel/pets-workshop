---
import Layout from "../layouts/Layout.astro";
---

<Layout title="دفتر الذكريات | رسائل وصور لا تُنسى">
  <section class="access-screen page-shell" id="access-screen" aria-labelledby="access-heading">
    <div class="welcome-copy">
      <span class="eyebrow"><span aria-hidden="true">✿</span> <span data-i18n="welcomeEyebrow">مكان صغير لأجمل حكاياتك</span></span>
      <h1 id="access-heading" data-i18n="welcomeTitle">كل ذكرى تستحقّ أن تُحفظ</h1>
      <p data-i18n="welcomeDescription">صورك، حكاياتك، والتفاصيل الصغيرة التي تحبين أن تعودي إليها… كلها هنا، في دفتر لا يفتحه سواك.</p>
    </div>

    <div class="gate-grid">
      <div class="envelope-scene" aria-hidden="true">
        <div class="pressed-flower flower-one">✿</div>
        <div class="pressed-flower flower-two">✿</div>
        <div class="envelope-shadow"></div>
        <div class="envelope">
          <div class="envelope-letter">
            <span data-i18n="envelopeLetter">إلى صاحبة هذه الذكريات</span>
            <span class="letter-mark">✦</span>
          </div>
          <div class="envelope-flap"></div>
          <div class="envelope-front"></div>
          <div class="envelope-seal">✿</div>
        </div>
        <p class="envelope-caption" data-i18n="envelopeCaption">على مهلٍ… هذه الحكايات لكِ</p>
      </div>

      <div class="access-paper">
        <span class="paper-corner" aria-hidden="true">✧</span>
        <span class="access-kicker" id="access-kicker">دفترك ينتظرك</span>
        <h2 id="access-title">افتحي دفتر الذكريات</h2>
        <p class="access-description" id="access-description">أدخلي كلمة السر لتعودي إلى حكاياتك وصورك.</p>

        <form class="password-form" id="password-form">
          <label for="password" id="password-label">كلمة السر</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="4"
            maxlength="128"
            required
            dir="ltr"
          />
          <div class="confirmation-field" id="confirmation-field" hidden>
            <label for="confirmation" data-i18n="passwordConfirmation">أكّدي كلمة السر</label>
            <input
              id="confirmation"
              name="confirmation"
              type="password"
              autocomplete="new-password"
              minlength="4"
              maxlength="128"
              dir="ltr"
            />
          </div>
          <button class="primary-button" id="access-button" type="submit">
            <span id="access-button-label">فتح الدفتر</span>
            <span aria-hidden="true">←</span>
          </button>
          <p class="form-message" id="access-message" role="status" aria-live="polite"></p>
        </form>

        <p class="privacy-note"><span aria-hidden="true">♧</span> <span id="privacy-note-text"></span></p>
      </div>
    </div>
  </section>

  <section class="gift-view page-shell" id="gift-view" aria-labelledby="gift-heading" hidden>
    <div class="gift-welcome">
      <span class="eyebrow"><span aria-hidden="true">✿</span> <span data-i18n="giftEyebrow">هدية من القلب</span></span>
      <h1 id="gift-heading" data-i18n="giftTitle">أعددتُ لك هذه الذكريات</h1>
      <p data-i18n="giftDescription">لحظات جميلة جمعتها لكِ في مكان واحد، أتمنى أن تعجبك.</p>
    </div>
    <div class="gift-access access-paper" id="gift-access">
      <span class="access-kicker" data-i18n="giftAccessKicker">رسالة خاصة</span>
      <h2 data-i18n="giftAccessTitle">افتحي هديتك</h2>
      <p data-i18n="giftAccessDescription">أدخلي كلمة السر التي وصلتك مع الرابط.</p>
      <form class="password-form" id="gift-password-form">
        <label for="gift-password" data-i18n="giftPasswordLabel">كلمة السر</label>
        <input id="gift-password" name="password" type="password" autocomplete="current-password" maxlength="128" required dir="ltr" />
        <button class="primary-button" type="submit"><span data-i18n="giftOpenButton">افتحي الهدية</span><span aria-hidden="true">←</span></button>
        <p class="form-message" id="gift-message" role="status" aria-live="polite"></p>
      </form>
      <p class="gift-not-ready" id="gift-not-ready" hidden data-i18n="giftNotReady">هذه الهدية لم تُجهّز للمشاركة بعد.</p>
    </div>
    <div class="gift-content" id="gift-content" hidden>
      <div class="memories-heading">
        <div>
          <span class="access-kicker" data-i18n="giftPages">صفحات أُعدّت لك</span>
          <h2 data-i18n="giftMemoriesTitle">ذكرياتك</h2>
        </div>
        <span class="memory-count" id="gift-memory-count"></span>
      </div>
      <div class="memories-grid" id="gift-memories-grid" aria-live="polite"></div>
      <div class="empty-state" id="gift-empty-state" hidden>
        <span aria-hidden="true">✿</span>
        <h3 data-i18n="giftEmptyTitle">تنتظرك هنا أول ذكرى</h3>
        <p data-i18n="giftEmptyDescription">ستظهر هنا الصور والحكايات التي أُعدّت لك.</p>
      </div>
    </div>
  </section>

  <section class="memory-book page-shell" id="memory-book" aria-labelledby="book-heading" hidden>
    <div class="book-heading">
      <div>
        <span class="eyebrow"><span aria-hidden="true">✿</span> <span data-i18n="bookEyebrow">أهلًا بعودتكِ</span></span>
        <h1 id="book-heading" data-i18n="bookHeading">مساحة لأيامك الجميلة</h1>
        <p data-i18n="bookDescription">اكتبي اللحظة كما تتذكرينها، وأرفقي الصورة التي تعيدك إليها.</p>
      </div>
      <button class="quiet-button" id="logout-button" type="button"><span data-i18n="logout">إغلاق الدفتر</span> <span aria-hidden="true">↗</span></button>
    </div>

    <div class="book-layout">
      <aside class="composer-paper" aria-labelledby="composer-heading">
        <span class="section-mark" aria-hidden="true">✦</span>
        <span class="access-kicker" data-i18n="composerKicker">لحظة تستحق الحفظ</span>
        <h2 id="composer-heading" data-i18n="composerHeading">أضيفي ذكرى</h2>
        <p class="composer-intro" data-i18n="composerIntro">حتى التفاصيل الصغيرة تكبر قيمتها حين ندوّنها.</p>

        <form class="memory-form" id="memory-form">
          <label for="memory-title" data-i18n="memoryTitleLabel">عنوان الذكرى</label>
          <input id="memory-title" name="title" type="text" maxlength="160" placeholder="يوم لا أنساه…" data-i18n-placeholder="memoryTitlePlaceholder" required />

          <label for="memory-story" data-i18n="memoryStoryLabel">حكاية الذكرى</label>
          <textarea id="memory-story" name="story" rows="5" maxlength="10000" placeholder="أين كنتِ؟ من كان معكِ؟ ما التفصيل الذي بقي في بالك؟" data-i18n-placeholder="memoryStoryPlaceholder" required></textarea>

          <label for="memory-date"><span data-i18n="memoryDateLabel">تاريخها</span> <span class="optional-label" data-i18n="optional">اختياري</span></label>
          <input id="memory-date" name="happened_on" type="date" />

          <label class="photo-picker" for="memory-photos">
            <span class="photo-icon" aria-hidden="true">＋</span>
            <span class="photo-picker-copy"><strong data-i18n="addPhotos">أرفقي صورًا</strong><small data-i18n="photoHelp">JPG أو PNG أو WEBP أو GIF · حتى 8 صور</small></span>
            <input id="memory-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
          </label>
          <div class="photo-preview" id="photo-preview" aria-live="polite"></div>

          <button class="primary-button save-button" id="save-button" type="submit">
            <span data-i18n="saveMemory">حفظ الذكرى</span><span aria-hidden="true">✧</span>
          </button>
          <p class="form-message" id="memory-message" role="status" aria-live="polite"></p>
        </form>
      </aside>

      <section class="memories-section" aria-labelledby="memories-heading">
        <div class="memories-heading">
          <div>
            <span class="access-kicker" data-i18n="savedPages">صفحاتك المحفوظة</span>
            <h2 id="memories-heading" data-i18n="memoriesTitle">ذكرياتك</h2>
          </div>
          <span class="memory-count" id="memory-count">٠ ذكريات</span>
        </div>
        <div class="memories-grid" id="memories-grid" aria-live="polite"></div>
        <div class="empty-state" id="empty-state">
          <span aria-hidden="true">✿</span>
          <h3 data-i18n="emptyTitle">هذه الصفحة ما زالت تنتظر حكايتها الأولى</h3>
          <p data-i18n="emptyDescription">ابدئي بذكرى واحدة؛ صورة، موعد، أو حكاية صغيرة تحبين الاحتفاظ بها.</p>
          <a href="#composer-heading"><span data-i18n="emptyAction">أضيفي أول ذكرى</span> <span aria-hidden="true">↑</span></a>
        </div>
      </section>
    </div>

    <details class="password-settings">
      <summary data-i18n="passwordSettingsTitle">تغيير كلمة السر</summary>
      <form class="change-password-form" id="change-password-form">
        <label for="current-password" data-i18n="currentPassword">كلمة السر الحالية</label>
        <input id="current-password" name="current" type="password" autocomplete="current-password" required dir="ltr" />
        <label for="new-password" data-i18n="newPassword">كلمة السر الجديدة</label>
        <input id="new-password" name="password" type="password" minlength="4" maxlength="128" autocomplete="new-password" required dir="ltr" />
        <label for="new-password-confirmation" data-i18n="newPasswordConfirmation">أكّدي كلمة السر الجديدة</label>
        <input id="new-password-confirmation" name="confirmation" type="password" minlength="4" maxlength="128" autocomplete="new-password" required dir="ltr" />
        <button class="secondary-button" type="submit" data-i18n="savePassword">حفظ كلمة السر الجديدة</button>
        <p class="form-message" id="password-message" role="status" aria-live="polite"></p>
      </form>
    </details>

    <details class="gift-settings" id="gift-settings">
      <summary data-i18n="giftSettingsTitle">تجهيز هدية للمشاركة</summary>
      <p data-i18n="giftSettingsDescription">أنشئي كلمة سر خاصة بالمستلم. سيتمكن من مشاهدة الصور والذكريات فقط، دون تعديلها.</p>
      <form class="change-password-form" id="gift-settings-form">
        <label for="gift-share-password" data-i18n="giftSharePassword">كلمة سر الهدية</label>
        <input id="gift-share-password" name="password" type="password" minlength="4" maxlength="128" autocomplete="new-password" required dir="ltr" />
        <label for="gift-share-confirmation" data-i18n="giftShareConfirmation">أكّدي كلمة سر الهدية</label>
        <input id="gift-share-confirmation" name="confirmation" type="password" minlength="4" maxlength="128" autocomplete="new-password" required dir="ltr" />
        <button class="secondary-button" type="submit" data-i18n="createGiftLink">إنشاء رابط الهدية</button>
        <p class="form-message" id="gift-settings-message" role="status" aria-live="polite"></p>
        <p class="gift-local-warning" id="gift-local-warning" hidden data-i18n="giftLocalWarning">الموقع يعمل الآن على جهازك فقط؛ الرابط المحلي لا يفتح عند المستلم. انشري الموقع على Render أولًا، ثم افتحيه هناك وأنشئي رابط الهدية من النسخة المنشورة.</p>
        <div class="gift-share-link" id="gift-share-link" hidden>
          <label for="gift-url" data-i18n="giftLinkLabel">رابط الهدية</label>
          <input id="gift-url" type="url" readonly dir="ltr" />
          <button class="secondary-button" id="copy-gift-link" type="button" data-i18n="copyGiftLink">نسخ الرابط</button>
          <p data-i18n="giftShareReminder">أرسلي الرابط وكلمة سر الهدية للمستلم. احتفظي بكلمة السر بأمان.</p>
        </div>
      </form>
    </details>
  </section>

  <template id="memory-template">
    <article class="memory-card">
      <div class="memory-photos"></div>
      <div class="memory-copy">
        <div class="memory-meta">
          <time class="memory-date"></time>
          <button class="delete-memory" type="button" aria-label="حذف هذه الذكرى" data-i18n-aria-label="deleteMemory" data-i18n="delete">حذف</button>
        </div>
        <h3 class="memory-title"></h3>
        <p class="memory-story"></p>
        <span class="photo-count"></span>
      </div>
    </article>
  </template>
</Layout>

<script>
  type ApiOptions = {
    method?: string;
    body?: BodyInit | null;
    headers?: HeadersInit;
  };
  type Language = "ar" | "en";
  type Memory = {
    id: number;
    title: string;
    story: string;
    happened_on: string | null;
    photos: Array<{ id: number; url: string }>;
  };
  type BookStatus = {
    configured: boolean;
    authenticated: boolean;
    csrf_token: string;
    password_min_length: number;
    public_deployment: boolean;
    ephemeral_storage: boolean;
  };

