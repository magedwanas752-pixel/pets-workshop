  function t(key: string, values: Record<string, string | number> = {}) {
    let text = translations[currentLanguage][key] || key;
    for (const [name, value] of Object.entries(values)) {
      text = text.replaceAll(`{${name}}`, String(value));
    }
    return text;
  }

  function applyLanguage() {
    document.documentElement.lang = currentLanguage;
    document.documentElement.dir = currentLanguage === "ar" ? "rtl" : "ltr";
    document.title = isGiftPage
      ? t("giftTitle") + (currentLanguage === "ar" ? " | هدية من القلب" : " | A gift from the heart")
      : t("brand") + (currentLanguage === "ar" ? " | رسائل وصور لا تُنسى" : " | Stories and photos to remember");
    const description = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    if (description) description.content = t("welcomeDescription");
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
      const key = element.dataset.i18n;
      if (key) element.textContent = t(key);
    });
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[data-i18n-placeholder]").forEach((element) => {
      const key = element.dataset.i18nPlaceholder;
      if (key) element.placeholder = t(key);
    });
    document.querySelectorAll<HTMLElement>("[data-i18n-aria-label]").forEach((element) => {
      const key = element.dataset.i18nAriaLabel;
      if (key) element.setAttribute("aria-label", t(key));
    });
    const languageButton = document.querySelector<HTMLButtonElement>("#language-toggle");
    if (languageButton) {
      languageButton.textContent = currentLanguage === "ar" ? "English" : "العربية";
      languageButton.setAttribute("aria-label", t("languageSwitch"));
      languageButton.lang = currentLanguage === "ar" ? "en" : "ar";
    }
    const footerLove = document.querySelector<HTMLElement>("#footer-love");
    if (footerLove) footerLove.textContent = t("footerLove");
    const privacyLabel = document.querySelector<HTMLElement>("#privacy-label");
    if (privacyLabel) privacyLabel.textContent = t(isGiftPage ? "giftPrivacyLabel" : "privacyLabel");
    if (isGiftPage) {
      const storageFooter = document.querySelector<HTMLElement>("#storage-footer");
      if (storageFooter) storageFooter.textContent = t("giftFooter");
    }
    if (currentBookStatus) {
      updateStorageCopy(currentBookStatus.public_deployment, currentBookStatus.ephemeral_storage);
      const localWarning = document.querySelector<HTMLElement>("#gift-local-warning");
      const giftLink = document.querySelector<HTMLElement>("#gift-share-link");
      if (localWarning) localWarning.hidden = currentBookStatus.public_deployment;
      if (giftLink) giftLink.hidden = !currentBookStatus.public_deployment || !giftEnabled;
      if (!currentBookStatus.authenticated && !isGiftPage) {
        setSetupMode(!currentBookStatus.configured, currentBookStatus.password_min_length);
      }
    }
    const giftPassword = document.querySelector<HTMLInputElement>("#gift-password");
    if (giftPassword && currentBookStatus) giftPassword.minLength = currentBookStatus.password_min_length;
    if (isGiftPage && giftAuthenticated) renderMemories(memoryCache, true);
    else if (!isGiftPage && currentBookStatus?.authenticated) renderMemories(memoryCache, false);
    const giftUrl = document.querySelector<HTMLInputElement>("#gift-url");
    if (giftUrl) giftUrl.value = `${window.location.origin}/?gift=1`;
  }

