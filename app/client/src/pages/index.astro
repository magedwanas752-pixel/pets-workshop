      "كلمتا السر الجديدتان غير متطابقتين.": t("newPasswordMismatch"),
      "كلمتا سر الهدية غير متطابقتين.": t("giftPasswordMismatch"),
      "يجب أن تختلف كلمة سر الهدية عن كلمة سر الدفتر.": "The gift password must be different from the book password.",
      "حدّثي الصفحة ثم حاولي مرة أخرى.": "Refresh the page and try again.",
      "تم إعداد كلمة السر بالفعل.": "The book password has already been set.",
      "ابدئي بإعداد كلمة سر الدفتر.": "Set up the book password first.",
      "محاولات كثيرة. انتظري قليلاً ثم حاولي مجدداً.": "Too many attempts. Wait a little, then try again.",
      "محاولات كثيرة. انتظري 15 دقيقة ثم حاولي مجدداً.": "Too many attempts. Wait 15 minutes, then try again.",
      "افتحي الدفتر بكلمة السر أولاً.": "Unlock the book with its password first.",
      "افتحي الهدية بكلمة السر أولاً.": "Open the gift with its password first.",
      "انتهت صلاحية الجلسة. حدّثي الصفحة وحاولي مرة أخرى.": "Your session expired. Refresh the page and try again.",
      "حجم الطلب أكبر من الحد المسموح به.": "The upload is larger than the allowed limit.",
      "تعذّر الاتصال بخدمة دفتر الذكريات.": "Could not connect to the memory book service.",
      "يجب ألا يتجاوز حجم الصورة الواحدة 10 ميجابايت.": "Each photo must be 10 MB or smaller.",
      "تعذّر قراءة إحدى الصور.": "One of the photos could not be read.",
      "أحد الملفات ليس صورة صالحة.": "One of the files is not a valid image.",
      "الصور المدعومة: JPG وPNG وWEBP وGIF.": "Supported formats: JPG, PNG, WEBP, and GIF.",
      "دقة الصورة كبيرة جداً.": "The photo dimensions are too large.",
      "اكتبي عنواناً للذكرى لا يتجاوز 160 حرفاً.": "Enter a memory title of no more than 160 characters.",
      "اكتبي حكاية صغيرة عن الذكرى.": "Write a short story for this memory.",
      "اختاري تاريخاً صحيحاً للذكرى.": "Choose a valid date for this memory.",
      "يمكنك إضافة 8 صور كحد أقصى للذكرى الواحدة.": "You can add up to 8 photos to each memory.",
      "لم نعثر على هذه الذكرى.": "This memory could not be found.",
      "لم تُجهّز هذه الهدية للمشاركة بعد.": t("giftNotReady"),
      "أرسل الرابط وكلمة السر للمستلم.": "Send the link and password to the recipient.",
      "تعذّر حفظ الذكرى. تأكدي من وجود مساحة كافية ثم حاولي مرة أخرى.": "Could not save the memory. Check available storage and try again.",
      "حُذفت الذكرى، لكن تعذّر حذف إحدى صورها من مساحة التخزين.": "The memory was deleted, but one photo could not be removed from storage.",
    };
    const minimum = message.match(/^اختاري كلمة سر من (\d+) إلى 128 خانة\.$/);
    if (minimum) return `Choose a password between ${minimum[1]} and 128 characters.`;
    return messages[message] || message;
