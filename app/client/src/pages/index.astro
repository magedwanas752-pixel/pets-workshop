  function showMessage(element: HTMLElement | null, message: string, isError = false) {
    if (!element) return;
    element.textContent = message;
    element.classList.toggle("is-error", isError);
  }

  async function api<T>(path: string, options: ApiOptions = {}): Promise<T> {
    const headers = new Headers(options.headers);
    if (csrfToken.value) headers.set("X-CSRF-Token", csrfToken.value);
    if (options.body && !(options.body instanceof FormData)) {
      headers.set("Content-Type", "application/json");
    }

    let response: Response;
    try {
      response = await fetch(`/api/${path}`, {
        ...options,
        headers,
        credentials: "same-origin",
      });
    } catch {
      throw new Error(t("connectionError"));
    }

    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      const error = new Error(translateServerError(data.error || t("unexpectedError")));
      Object.assign(error, { status: response.status });
      throw error;
    }
    return data as T;
  }

  function setSetupMode(isSetup: boolean, passwordMinLength: number) {
    const title = document.querySelector<HTMLElement>("#access-title");
    const kicker = document.querySelector<HTMLElement>("#access-kicker");
    const description = document.querySelector<HTMLElement>("#access-description");
    const passwordLabel = document.querySelector<HTMLElement>("#password-label");
    const passwordInput = document.querySelector<HTMLInputElement>("#password");
    const confirmationField = document.querySelector<HTMLElement>("#confirmation-field");
    const confirmationInput = document.querySelector<HTMLInputElement>("#confirmation");
    const buttonLabel = document.querySelector<HTMLElement>("#access-button-label");

    if (!title || !kicker || !description || !passwordLabel || !passwordInput ||
      !confirmationField || !confirmationInput || !buttonLabel) return;

    title.textContent = t(isSetup ? "setupTitle" : "loginTitle");
    kicker.textContent = t(isSetup ? "setupKicker" : "loginKicker");
    description.textContent = isSetup
      ? t("setupDescription", { count: new Intl.NumberFormat(currentLanguage === "ar" ? "ar" : "en-US").format(passwordMinLength) })
      : t("loginDescription");
    passwordLabel.textContent = t(isSetup ? "setupPasswordLabel" : "loginPasswordLabel");
    passwordInput.autocomplete = isSetup ? "new-password" : "current-password";
    passwordInput.minLength = passwordMinLength;
    confirmationField.hidden = !isSetup;
    confirmationInput.required = isSetup;
    confirmationInput.minLength = passwordMinLength;
    buttonLabel.textContent = t(isSetup ? "setupButton" : "loginButton");
    showMessage(accessMessage, "");
  }

  function updateStorageCopy(publicDeployment: boolean, ephemeralStorage = false) {
    const storageMessage = t(
      publicDeployment ? (ephemeralStorage ? "storageEphemeral" : "storagePublic") : "storageLocal",
    );
    const privacyNote = document.querySelector<HTMLElement>("#privacy-note-text");
    const storageFooter = document.querySelector<HTMLElement>("#storage-footer");
    if (privacyNote) privacyNote.textContent = storageMessage;
    if (storageFooter) storageFooter.textContent = storageMessage;
  }

  async function refreshBook() {
    if (isGiftPage) {
      await refreshGift();
      return;
    }
    const status = await api<BookStatus>("auth/status");
    currentBookStatus = status;
    csrfToken.value = status.csrf_token;
    const newPasswordInput = document.querySelector<HTMLInputElement>("#new-password");
    const newPasswordConfirmation = document.querySelector<HTMLInputElement>("#new-password-confirmation");
    updateStorageCopy(status.public_deployment, status.ephemeral_storage);
    if (newPasswordInput) newPasswordInput.minLength = status.password_min_length;
    if (newPasswordConfirmation) newPasswordConfirmation.minLength = status.password_min_length;
    const giftPassword = document.querySelector<HTMLInputElement>("#gift-share-password");
    const giftConfirmation = document.querySelector<HTMLInputElement>("#gift-share-confirmation");
    if (giftPassword) giftPassword.minLength = status.password_min_length;
    if (giftConfirmation) giftConfirmation.minLength = status.password_min_length;

    if (!accessScreen || !memoryBook) return;
    accessScreen.hidden = status.authenticated;
    memoryBook.hidden = !status.authenticated;
    if (status.authenticated) {
      try {
        await loadMemories();
        const giftSettings = await api<{ enabled: boolean }>("gift/settings");
        giftEnabled = giftSettings.enabled;
        const giftLink = document.querySelector<HTMLElement>("#gift-share-link");
        const giftUrl = document.querySelector<HTMLInputElement>("#gift-url");
        if (giftLink) giftLink.hidden = !status.public_deployment || !giftEnabled;
        if (giftUrl && status.public_deployment) giftUrl.value = `${window.location.origin}/?gift=1`;
        const localWarning = document.querySelector<HTMLElement>("#gift-local-warning");
        if (localWarning) localWarning.hidden = status.public_deployment;
      } catch (error) {
        showMessage(memoryMessage, error instanceof Error ? error.message : t("memoriesLoadError"), true);
      }
    } else {
      setSetupMode(!status.configured, status.password_min_length);
    }
  }

  async function refreshGift() {
    const status = await api<{
      enabled: boolean;
      authenticated: boolean;
      csrf_token: string;
      password_min_length: number;
    }>("gift/status");
    csrfToken.value = status.csrf_token;
    giftEnabled = status.enabled;
    giftAuthenticated = status.authenticated;
    const giftAccess = document.querySelector<HTMLElement>("#gift-access");
    const giftForm = document.querySelector<HTMLElement>("#gift-password-form");
    const notReady = document.querySelector<HTMLElement>("#gift-not-ready");
    const giftContent = document.querySelector<HTMLElement>("#gift-content");
    const giftPassword = document.querySelector<HTMLInputElement>("#gift-password");
    if (giftAccess) giftAccess.hidden = status.authenticated;
    if (giftForm) giftForm.hidden = !status.enabled;
    if (notReady) notReady.hidden = status.enabled;
    if (giftContent) giftContent.hidden = !status.authenticated;
    if (giftPassword) giftPassword.minLength = status.password_min_length;
    if (status.authenticated) {
      await loadMemories(true);
    } else {
      showMessage(giftMessage, status.enabled ? "" : t("giftNotReady"));
    }
  }

  async function loadMemories(isGift = false) {
    memoryCache = await api<Memory[]>(isGift ? "gift/memories" : "memories");
    renderMemories(memoryCache, isGift);
  }

  function renderMemories(memories: Memory[], isGift: boolean) {
    const gridSelector = isGift ? "#gift-memories-grid" : "#memories-grid";
    const emptySelector = isGift ? "#gift-empty-state" : "#empty-state";
    const countSelector = isGift ? "#gift-memory-count" : "#memory-count";
    const grid = document.querySelector<HTMLElement>(gridSelector);
    const emptyState = document.querySelector<HTMLElement>(emptySelector);
    const count = document.querySelector<HTMLElement>(countSelector);
    const template = document.querySelector<HTMLTemplateElement>("#memory-template");
    if (!grid || !emptyState || !count || !template) return;

    grid.replaceChildren();
    emptyState.hidden = memories.length > 0;
    const memoryCountKey = memories.length === 1
      ? "memoryCountOne"
      : memories.length === 2 ? "memoryCountTwo" : "memoryCount";
    count.textContent = t(memoryCountKey, {
      count: new Intl.NumberFormat(currentLanguage === "ar" ? "ar" : "en-US").format(memories.length),
    });

    for (const memory of memories) {
      const card = template.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
      if (!card) continue;
      const title = card.querySelector<HTMLElement>(".memory-title");
      const story = card.querySelector<HTMLElement>(".memory-story");
      const dateElement = card.querySelector<HTMLTimeElement>(".memory-date");
      const photoArea = card.querySelector<HTMLElement>(".memory-photos");
      const photoCount = card.querySelector<HTMLElement>(".photo-count");
      const deleteButton = card.querySelector<HTMLButtonElement>(".delete-memory");
      if (!title || !story || !dateElement || !photoArea || !photoCount || !deleteButton) continue;

      title.textContent = memory.title;
      story.textContent = memory.story;
      deleteButton.textContent = t("delete");
      deleteButton.setAttribute("aria-label", t("deleteMemory"));
      if (memory.happened_on) {
        dateElement.dateTime = memory.happened_on;
        dateElement.textContent = new Intl.DateTimeFormat(currentLanguage === "ar" ? "ar" : "en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        }).format(new Date(`${memory.happened_on}T12:00:00`));
      } else {
        dateElement.textContent = t("memoryWithoutDate");
      }

      if (memory.photos.length) {
        photoArea.classList.toggle("multiple-photos", memory.photos.length > 1);
        for (const photo of memory.photos) {
          const image = document.createElement("img");
          image.src = photo.url;
          image.alt = t("imageAlt", { title: memory.title });
          image.loading = "lazy";
          photoArea.append(image);
        }
        const photoCountKey = memory.photos.length === 1
          ? "photoCountOne"
          : memory.photos.length === 2 ? "photoCountTwo" : "photoCount";
        photoCount.textContent = t(photoCountKey, {
          count: new Intl.NumberFormat(currentLanguage === "ar" ? "ar" : "en-US").format(memory.photos.length),
        });
      } else {
        photoArea.hidden = true;
        photoCount.textContent = t("writtenMemory");
      }

      deleteButton.hidden = isGift;
      if (!isGift) deleteButton.addEventListener("click", async () => {
        if (!window.confirm(t("deleteConfirmation"))) return;
        deleteButton.disabled = true;
        try {
          await api(`memories/${memory.id}`, { method: "DELETE" });
          await loadMemories();
        } catch (error) {
          showMessage(memoryMessage, error instanceof Error ? error.message : t("deleteError"), true);
          deleteButton.disabled = false;
        }
      });
      grid.append(card);
    }
  }

  document.querySelector<HTMLButtonElement>("#language-toggle")?.addEventListener("click", () => {
    currentLanguage = currentLanguage === "ar" ? "en" : "ar";
    localStorage.setItem("memory-book-language", currentLanguage);
    applyLanguage();
  });

  giftPasswordForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const password = String(new FormData(giftPasswordForm).get("password") || "");
    const button = giftPasswordForm.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) button.disabled = true;
    showMessage(giftMessage, t("openingPages"));
    try {
      await api("gift/login", { method: "POST", body: JSON.stringify({ password }) });
      giftPasswordForm.reset();
      await refreshGift();
    } catch (error) {
      showMessage(giftMessage, error instanceof Error ? error.message : t("giftError"), true);
    } finally {
      if (button) button.disabled = false;
    }
  });

  accessForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!accessButton) return;
    const formData = new FormData(accessForm);
    const password = String(formData.get("password") || "");
    const confirmation = String(formData.get("confirmation") || "");
    const isSetup = !document.querySelector<HTMLElement>("#confirmation-field")?.hidden;
    if (isSetup && password !== confirmation) {
      showMessage(accessMessage, t("setupMismatch"), true);
      return;
    }
    accessButton.disabled = true;
    showMessage(accessMessage, isSetup ? t("savingPassword") : t("openingPages"));
    try {
      await api(isSetup ? "auth/setup" : "auth/login", {
        method: "POST",
        body: JSON.stringify({ password, confirmation }),
      });
      accessForm.reset();
      await refreshBook();
    } catch (error) {
      showMessage(accessMessage, error instanceof Error ? error.message : t("openError"), true);
    } finally {
      accessButton.disabled = false;
    }
  });

  memoryForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const saveButton = document.querySelector<HTMLButtonElement>("#save-button");
    if (saveButton) saveButton.disabled = true;
    showMessage(memoryMessage, t("arrangingMemory"));
    try {
      const formData = new FormData(memoryForm);
      await api("memories", { method: "POST", body: formData });
      memoryForm.reset();
      updatePhotoPreview();
      showMessage(memoryMessage, t("memorySaved"));
      await loadMemories();
    } catch (error) {
      showMessage(memoryMessage, error instanceof Error ? error.message : t("saveError"), true);
    } finally {
      if (saveButton) saveButton.disabled = false;
    }
  });

  function updatePhotoPreview() {
    const preview = document.querySelector<HTMLElement>("#photo-preview");
    const input = document.querySelector<HTMLInputElement>("#memory-photos");
    if (!preview || !input) return;
    preview.replaceChildren();
    const files = Array.from(input.files || []);
    files.slice(0, 8).forEach((file) => {
      if (!file.type.startsWith("image/")) return;
      const image = document.createElement("img");
      image.alt = file.name;
      image.src = URL.createObjectURL(file);
      image.onload = () => URL.revokeObjectURL(image.src);
      preview.append(image);
    });
    if (files.length > 8) {
      showMessage(memoryMessage, t("maxPhotos"), true);
    }
  }

  document.querySelector<HTMLInputElement>("#memory-photos")?.addEventListener("change", updatePhotoPreview);

  document.querySelector<HTMLButtonElement>("#logout-button")?.addEventListener("click", async () => {
    try {
      await api("auth/logout", { method: "POST" });
      await refreshBook();
    } catch (error) {
      showMessage(memoryMessage, error instanceof Error ? error.message : t("closeError"), true);
    }
  });

  document.querySelector<HTMLFormElement>("#change-password-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const message = document.querySelector<HTMLElement>("#password-message");
    const fields = new FormData(form);
    const password = String(fields.get("password") || "");
    if (password !== String(fields.get("confirmation") || "")) {
      showMessage(message, t("newPasswordMismatch"), true);
      return;
    }
    try {
      await api("auth/password", {
        method: "POST",
        body: JSON.stringify({
          current: fields.get("current"),
          password,
          confirmation: fields.get("confirmation"),
        }),
      });
      form.reset();
      showMessage(message, t("passwordChanged"));
    } catch (error) {
      showMessage(message, error instanceof Error ? error.message : t("passwordChangeError"), true);
    }
  });

  giftSettingsForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const fields = new FormData(form);
    const password = String(fields.get("password") || "");
    const confirmation = String(fields.get("confirmation") || "");
    const message = document.querySelector<HTMLElement>("#gift-settings-message");
    if (password !== confirmation) {
      showMessage(message, t("giftPasswordMismatch"), true);
      return;
    }
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button) button.disabled = true;
    try {
      await api("gift/settings", {
        method: "POST",
        body: JSON.stringify({ password, confirmation }),
      });
      form.reset();
      showMessage(
        message,
        currentBookStatus?.public_deployment ? t("giftLinkCreated") : t("giftSavedLocally"),
        !currentBookStatus?.public_deployment,
      );
      const link = document.querySelector<HTMLElement>("#gift-share-link");
      const url = document.querySelector<HTMLInputElement>("#gift-url");
      const localWarning = document.querySelector<HTMLElement>("#gift-local-warning");
      if (currentBookStatus?.public_deployment) {
        if (url) url.value = `${window.location.origin}/?gift=1`;
        if (link) link.hidden = false;
        if (localWarning) localWarning.hidden = true;
      } else {
        if (link) link.hidden = true;
        if (localWarning) localWarning.hidden = false;
      }
    } catch (error) {
      showMessage(message, error instanceof Error ? error.message : t("giftError"), true);
    } finally {
      if (button) button.disabled = false;
    }
  });

  document.querySelector<HTMLButtonElement>("#copy-gift-link")?.addEventListener("click", async () => {
    const url = document.querySelector<HTMLInputElement>("#gift-url");
    const message = document.querySelector<HTMLElement>("#gift-settings-message");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url.value);
      showMessage(message, t("giftLinkCopied"));
    } catch {
      url.focus();
      url.select();
      showMessage(message, t("giftLinkCopyError"), true);
    }
  });

  if (isGiftPage) {
    if (accessScreen) accessScreen.hidden = true;
    if (memoryBook) memoryBook.hidden = true;
    if (giftView) giftView.hidden = false;
  }
  applyLanguage();
  refreshBook().catch((error) => {
    showMessage(isGiftPage ? giftMessage : accessMessage, error instanceof Error ? error.message : t("loadError"), true);
  });
</script>

